{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "bump-minor-pre-major": true,
  "include-v-in-tag": true,
  "include-v-in-release-name": true,
  "pull-request-title-pattern": "chore: release ${version}",
  "changelog-sections": [
    {
      "type": "feat",
      "section": "Features"
    },
    {
      "type": "fix",
      "section": "Bug Fixes"
    },
    {
      "type": "perf",
      "section": "Performance"
    },
    {
      "type": "refactor",
      "section": "Refactoring"
    },
    {
      "type": "docs",
      "section": "Documentation"
    },
    {
      "type": "revert",
      "section": "Reverts"
    },
    {
      "type": "ci",
      "section": "CI and Security",
      "hidden": true
    },
    {
      "type": "build",
      "section": "Build",
      "hidden": true
    },
    {
      "type": "test",
      "section": "Tests",
      "hidden": true
    },
    {
      "type": "chore",
      "section": "Maintenance",
      "hidden": true
    }
  ],
  "packages": {
    ".": {
      "release-type": "node",
      "package-name": "canvas",
      "changelog-path": "CHANGELOG.md"
    }
  }
}
